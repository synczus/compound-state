[Unit]
Description=Synapse Compound Dashboard
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=synczus
Group=synczus
WorkingDirectory=/home/synczus/kestrel
ExecStart=/home/synczus/kestrel/.venv/bin/python3 /home/synczus/kestrel/synapse/server.py
Restart=always
RestartSec=5
Environment=SYNAPSE_PORT=3333
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target