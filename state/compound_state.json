{
  "description": "Kestrel Compound State Schema — designed by Perplexity Round 3 (brain-dump-hop 2026-06-07). Single source of truth for system health, source scoring, budget tracking, and alerting.",
  "schema": {
    "timestamp": "ISO8601 UTC — last update time",
    "budget": {
      "usd_remaining": "float — remaining daily budget",
      "guard_pause_threshold": "float — USD at which ingestion pauses (default 2.00)",
      "last_spend_usd": "float — spend since last reset"
    },
    "agents": {
      "<agent_name>": {
        "status": "online|degraded|offline|deprecated",
        "last_heartbeat": "ISO8601 UTC",
        "last_error": "string — last error message or null",
        "restart_count": "integer"
      }
    },
    "sources": {
      "<source_id>": {
        "tier": "lead_indicator|catalyst_confirmation|narrative_formation|archival_reference",
        "enabled": "boolean",
        "last_seen": "ISO8601 UTC — last successful fetch",
        "cadence_minutes": "integer — expected interval",
        "health_score": "float 0-100 — daily computed",
        "quality_score": "float 0-100 — relevance hit rate",
        "parse_fail_rate": "float 0-1 — failures / total fetches",
        "relevance_hit_rate": "float 0-1 — useful signals / total",
        "drop_order": "integer 1-4 — degradation priority"
      }
    },
    "alerts": [
      {
        "source": "source_id or agent_name",
        "severity": "critical|warning|info",
        "reason": "string describing the issue",
        "created_at": "ISO8601 UTC"
      }
    ],
    "version": "string — schema version"
  },
  "initial_state": {
    "timestamp": null,
