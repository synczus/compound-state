"""
Kestrel Striker — entry point for the live market scanner daemon.

Architecture:
  MarketScanner  --[Tick]--> asyncio.Queue --[Tick]--> SignalRouter --> Telegram

Run locally:
  python core/main.py

Run via systemd:
  sudo systemctl start kestrel-striker
"""
import asyncio
import logging
import signal
import sys
from pathlib import Path

# Add kestrel root to path when invoked as `python core/main.py`
_ROOT = Path(__file__).parent.parent
if str(_ROOT) not in sys.path:
    sys.path.insert(0, str(_ROOT))

# Load .env from kestrel root if vars are not already in env
_ENV_PATH = _ROOT / ".env"
if _ENV_PATH.is_file():
    import os
    for _line in _ENV_PATH.read_text().splitlines():
        _line = _line.strip()
        if not _line or _line.startswith("#") or "=" not in _line:
            continue
        _k, _v = _line.split("=", 1)
        _k = _k.strip()
        if _k and _k not in os.environ:
            os.environ[_k] = _v.strip()

from scanner.live_ingest import MarketScanner
from signals.engine import SignalRouter
from core.config import QUEUE_MAX_SIZE, SCAN_SYMBOLS

logging.basicConfig(
    level=logging.INFO,
    format="%(asctime)s [%(levelname)s] %(name)s: %(message)s",
    stream=sys.stdout,
)
logger = logging.getLogger("kestrel.main")


async def main() -> None:
    logger.info("Kestrel Striker starting | symbols=%s", SCAN_SYMBOLS)

    data_queue: asyncio.Queue = asyncio.Queue(maxsize=QUEUE_MAX_SIZE)

    scanner = MarketScanner(queue=data_queue)
    router = SignalRouter(queue=data_queue)

    loop = asyncio.get_running_loop()

    def _shutdown(sig_name: str) -> None:
        logger.info("Received %s — initiating graceful shutdown...", sig_name)
        scanner.stop()
        router.stop()

    for sig in (signal.SIGTERM, signal.SIGINT):
        loop.add_signal_handler(sig, _shutdown, sig.name)

    try:
        await asyncio.gather(
            scanner.listen(),
            router.process_loop(),
        )
    except asyncio.CancelledError:
        pass

    logger.info("Kestrel Striker stopped.")


if __name__ == "__main__":
    try:
        asyncio.run(main())
    except KeyboardInterrupt:
        print("Graceful shutdown initiated.")
