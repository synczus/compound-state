[Unit]
Description=Auto-improve feedback collector — logs agent outputs to AgentMemory every 30 min
Documentation=https://github.com/kestrelmarkets/auto-improve
Wants=agentmemory.service
After=agentmemory.service network-online.target

[Service]
Type=oneshot
User=synczus
Group=synczus
PrivateUsers=false
WorkingDirectory=/home/synczus/kestrel/scripts/auto-improve
Environment=AGENTMEMORY_URL=http://localhost:3111
Environment=FEEDBACK_LOOP_COUNT=50
Environment=FEEDBACK_PIPELINE_LINES=200
ExecStart=/home/synczus/kestrel/scripts/auto-improve/feedback-collector.py
StandardOutput=journal
StandardError=journal
SuccessExitStatus=0 1 216

[Install]
WantedBy=default.target
